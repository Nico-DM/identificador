SERPAPI_API_KEY=tu_clave_serpapi
SERPAPI_ENDPOINT=https://serpapi.com/search.json
SERPAPI_ENGINE=google_lens
SEARCH_TTL_SECONDS=900
ENVIRONMENT=development

# Scraping paralelo (fase estatica → busqueda profunda opcional)
# SCRAPE_STATIC_MAX_WORKERS=8
# SCRAPE_DYNAMIC_MAX_WORKERS=2
# SCRAPE_STATIC_CONFIDENCE_THRESHOLD=0.55
# SCRAPE_DYNAMIC_ENABLED=true  # habilita boton de busqueda profunda (no se ejecuta automaticamente)

