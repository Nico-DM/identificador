SERPAPI_API_KEY=tu_clave_serpapi
SERPAPI_ENDPOINT=https://serpapi.com/search.json
SERPAPI_ENGINE=google_lens
SEARCH_TTL_SECONDS=900
ENVIRONMENT=development

# Supabase / Postgres (opcional; sin esto el estado queda en memoria)
# Shared Pooler (Session, IPv4) — copiar host/user del panel Supabase
# DATABASE_URL=postgresql://postgres.[ref]:x@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# DATABASE_PASSWORD=contraseña_del_proyecto
# CACHE_TTL_SECONDS=604800

# Supabase Storage (requerido para subida por archivo; plan Free incluye 1 GB)
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_secret
# STORAGE_BUCKET=search-uploads
# UPLOAD_MAX_BYTES=5242880

# Scraping paralelo (fase estatica → busqueda profunda opcional)
# SCRAPE_STATIC_MAX_WORKERS=8
# SCRAPE_DYNAMIC_MAX_WORKERS=2
# SCRAPE_STATIC_CONFIDENCE_THRESHOLD=0.55
# SCRAPE_DYNAMIC_ENABLED=true  # habilita boton de busqueda profunda (no se ejecuta automaticamente)

