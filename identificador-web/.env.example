# Backend API URL (sin path; solo origen)
# Desarrollo local:
BACKEND_API_URL=http://localhost:8000

# Producción (Vercel): Settings → Environment Variables → Production (y Preview si aplica)
# BACKEND_API_URL=https://identificador-3gb4.onrender.com

# Polling de resultados (cliente; prefijo NEXT_PUBLIC_ obligatorio)
# NEXT_PUBLIC_POLL_MAX_ATTEMPTS=60
# NEXT_PUBLIC_POLL_DELAY_MS=2000
